@model LoginViewModel
@{
    Layout = null;
    var activeTab = (string)(ViewBag.ActiveTab ?? "login");
    var isRegister = string.Equals(activeTab, "register", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#070b1a">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap">
    <script src="~/js/theme.js"></script>
    <title>Вход и регистрация — EzShop</title>
    <link rel="stylesheet" href="~/style.css" asp-append-version="true">
    <style>
        @@keyframes loaderPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        @@keyframes loaderPulseLight {
            0%, 100% { transform: scale(1); filter: invert(1) hue-rotate(180deg) saturate(1.3); }
            50% { transform: scale(1.05); filter: invert(1) hue-rotate(180deg) saturate(1.3); }
        }
        :root[data-theme="light"] .logo img,
        :root[data-theme="light"] .auth-logo {
            filter: invert(1) hue-rotate(180deg) saturate(1.3) !important;
        }
        :root[data-theme="light"] .loader-logo,
        html[data-theme="light"] .loader-logo,
        [data-theme="light"] .loader-logo {
            filter: invert(1) hue-rotate(180deg) saturate(1.3) !important;
            animation: loaderIn .5s .12s both, loaderPulseLight 2.4s 0.6s infinite ease-in-out !important;
            will-change: transform, filter;
        }
    </style>
</head>
<body class="auth-loading">
    <!-- Анимация загрузки страницы с логотипом -->
    <div class="loader-overlay" id="pageLoader">
        <img src="~/img/logo.png" alt="Загрузка" class="loader-logo">
        <div class="loader-bar"><span></span></div>
    </div>

    <main class="auth-page">
        <!-- Левая витрина (на широких экранах) -->
        <section class="auth-showcase" aria-hidden="true">
            <div class="auth-orb orb-a"></div>
            <div class="auth-orb orb-b"></div>
            <div class="auth-showcase-inner">
                <h2>Лучшие смартфоны — <em>в одном месте</em></h2>
                <p>Сравнивайте характеристики, следите за заказами и покупайте технику с гарантией.</p>
                <ul class="auth-perks">
                    <li><span class="perk-ico" data-icon="shield-check"></span>Гарантия 1 год на всю технику</li>
                    <li><span class="perk-ico" data-icon="truck"></span>Быстрая доставка по Кыргызстану</li>
                    <li><span class="perk-ico" data-icon="refresh"></span>14 дней на обмен и возврат</li>
                </ul>
            </div>
            <div class="auth-phones">
                <div class="auth-phone"><img src="~/img/iPhone 15 pro max.jpg" alt="iPhone 15 Pro Max"></div>
                <div class="auth-phone"><img src="~/img/samsung galaxy s24 ultra.jpg" alt="Samsung Galaxy S24 Ultra"></div>
                <div class="auth-phone"><img src="~/img/xiaomi 14 ultra.jpg" alt="Xiaomi 14 Ultra"></div>
            </div>
        </section>

        <!-- Форма авторизации и регистрации -->
        <section class="auth-panel">
            <div class="auth-container">
                <div class="auth-brand">
                    <a asp-controller="Catalog" asp-action="Index" title="На главную в каталог">
                        <img src="~/img/logo.png" alt="EzShop" class="auth-logo">
                    </a>
                </div>
                <h1 class="auth-title" id="authTitle">@(isRegister ? "Создайте аккаунт" : "С возвращением")</h1>
                <p class="auth-sub" id="authSub">@(isRegister ? "Это займёт меньше минуты" : "Войдите в личный кабинет EzShop")</p>

                <div class="auth-tabs" role="tablist" data-active="@(isRegister ? "register" : "login")">
                    <button type="button" class="auth-tab @(!isRegister ? "active" : "")" role="tab" aria-selected="@(!isRegister ? "true" : "false")" onclick="switchTab('login')">Вход</button>
                    <button type="button" class="auth-tab @(isRegister ? "active" : "")" role="tab" aria-selected="@(isRegister ? "true" : "false")" onclick="switchTab('register')">Регистрация</button>
                    <span class="auth-tab-indicator" aria-hidden="true"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 13px;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Форма Входа -->
                <form id="loginForm" asp-controller="Account" asp-action="Login" method="post" class="auth-form @(!isRegister ? "active" : "")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="field">
                        <input asp-for="Login" id="loginInput" class="auth-input" placeholder=" " autocomplete="username" required />
                        <label for="loginInput">Логин или Email</label>
                    </div>

                    <div class="field password-wrapper">
                        <input asp-for="Password" id="loginPass" type="password" class="auth-input" placeholder=" " autocomplete="current-password" required />
                        <label for="loginPass">Пароль</label>
                        <button type="button" class="toggle-password" onclick="togglePassword('loginPass')" aria-label="Показать пароль"></button>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 13.5px; color: var(--muted);">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input asp-for="RememberMe" type="checkbox" style="cursor: pointer;" />
                            <span>Запомнить меня</span>
                        </label>
                    </div>

                    <button type="submit" class="auth-btn auth-submit">
                        <span class="btn-label">Войти</span>
                    </button>

                    <p class="auth-switch">
                        Нет аккаунта? <button type="button" onclick="switchTab('register')" style="background:none; border:none; color:var(--primary); font-weight:700; cursor:pointer;">Создать</button>
                    </p>
                </form>

                <!-- Форма Регистрации -->
                <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" class="auth-form @(isRegister ? "active" : "")">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <input type="text" name="Username" id="regName" class="auth-input" placeholder=" " autocomplete="username" required minlength="2" value="@(ViewBag.RegUsername ?? "")" />
                        <label for="regName">Логин</label>
                    </div>

                    <div class="field">
                        <input type="email" name="Email" id="regEmail" class="auth-input" placeholder=" " autocomplete="email" required value="@(ViewBag.RegEmail ?? "")" />
                        <label for="regEmail">Email</label>
                    </div>

                    <div class="field password-wrapper">
                        <input type="password" name="Password" id="regPass" class="auth-input" placeholder=" " autocomplete="new-password" required minlength="6" oninput="updateStrength(this.value)" />
                        <label for="regPass">Пароль (от 6 символов)</label>
                        <button type="button" class="toggle-password" onclick="togglePassword('regPass')" aria-label="Показать пароль"></button>
                    </div>

                    <div class="strength" id="strength" aria-live="polite">
                        <div class="strength-bars"><i></i><i></i><i></i><i></i></div>
                        <span class="strength-text" id="strengthText">Введите пароль</span>
                    </div>

                    <button type="submit" class="auth-btn auth-submit">
                        <span class="btn-label">Зарегистрироваться</span>
                    </button>

                    <p class="auth-switch">
                        Уже есть аккаунт? <button type="button" onclick="switchTab('login')" style="background:none; border:none; color:var(--primary); font-weight:700; cursor:pointer;">Войти</button>
                    </p>
                </form>
            </div>
        </section>
    </main>

    <div class="toast-container" id="toastContainer" aria-live="polite"></div>

    <script src="~/js/icons.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/ui.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-icon]').forEach(el => {
                if (typeof window.EZ_ICON === 'function') el.innerHTML = window.EZ_ICON(el.dataset.icon);
            });
            document.querySelectorAll('.toggle-password').forEach(b => {
                if (typeof window.EZ_ICON === 'function') b.innerHTML = window.EZ_ICON('eye');
            });
        });

        function switchTab(tab) {
            const isLogin = tab === 'login';
            const tabs = document.querySelectorAll('.auth-tab');
            tabs.forEach((t, i) => {
                const on = (i === 0) === isLogin;
                t.classList.toggle('active', on);
                t.setAttribute('aria-selected', String(on));
            });
            document.querySelector('.auth-tabs').dataset.active = tab;
            document.getElementById('loginForm').classList.toggle('active', isLogin);
            document.getElementById('registerForm').classList.toggle('active', !isLogin);
            document.getElementById('authTitle').textContent = isLogin ? 'С возвращением' : 'Создайте аккаунт';
            document.getElementById('authSub').textContent = isLogin
                ? 'Войдите в личный кабинет EzShop'
                : 'Это займёт меньше минуты';
            const first = document.querySelector('.auth-form.active .auth-input');
            if (first && window.matchMedia('(hover: hover)').matches) first.focus({ preventScroll: true });
        }

        function updateStrength(v) {
            let score = 0;
            if (v.length >= 6) score++;
            if (v.length >= 10) score++;
            if (/[A-ZА-Я]/.test(v) && /[a-zа-я]/.test(v)) score++;
            if (/\d/.test(v) && /[^A-Za-zА-Яа-я0-9]/.test(v)) score++;
            if (!v) score = 0;
            const box = document.getElementById('strength');
            box.dataset.level = String(score);
            const labels = ['Введите пароль', 'Слабый', 'Средний', 'Хороший', 'Надёжный'];
            document.getElementById('strengthText').textContent = labels[score];
        }

        document.getElementById('loginForm')?.addEventListener('submit', function () {
            const btn = this.querySelector('.auth-submit');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="btn-label">Вход в магазин...</span>';
            }
        });

        document.getElementById('registerForm')?.addEventListener('submit', function () {
            const btn = this.querySelector('.auth-submit');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="btn-label">Создание аккаунта...</span>';
            }
        });
    </script>
</body>
</html>
