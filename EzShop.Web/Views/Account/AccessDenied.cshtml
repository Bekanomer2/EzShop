@{
    ViewData["Title"] = "Доступ ограничен";
}

<div style="max-width: 600px; margin: 80px auto; padding: 40px 24px; text-align: center; background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 20px;">
    <div style="font-size: 48px; margin-bottom: 12px;">🚫</div>
    <h1 style="color: #f87171; font-size: 26px; font-weight: 700; margin-bottom: 10px;">Доступ ограничен</h1>
    <p style="color: #cbd5e1; font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
        Этот раздел предназначен исключительно для <b>Администратора магазина</b>.<br />
        Пожалуйста, войдите под учетной записью с ролью <code>Admin</code>.
    </p>

    <div style="display: flex; justify-content: center; gap: 12px;">
        <a asp-action="Login" asp-controller="Account" style="padding: 10px 20px; background: #38bdf8; color: #0f172a; font-weight: 700; border-radius: 8px; text-decoration: none;">
            Войти как Администратор
        </a>
        <a asp-action="Index" asp-controller="Catalog" style="padding: 10px 20px; background: rgba(255,255,255,0.1); color: #cbd5e1; font-weight: 600; border-radius: 8px; text-decoration: none;">
            В каталог
        </a>
    </div>
</div>
